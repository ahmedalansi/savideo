# Leave empty to use the built-in fake data layer (seed data, no backend needed).
# Set to the FastAPI base URL once /replica-backend has run, e.g. https://api.savideo.example/v1
NEXT_PUBLIC_API_BASE=
# Optional with the real API: a public video you are allowed to share, used by the "Try a demo video" link.
NEXT_PUBLIC_DEMO_URL=
# Seconds the progress + ad window stays up after Download (default 8). 0 turns it off.
NEXT_PUBLIC_WAIT_AD_SECONDS=
