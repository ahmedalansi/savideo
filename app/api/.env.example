# Copy to .env on the server and fill in. Never commit .env.
# Long random string (e.g. `openssl rand -hex 32`): signs cookies and thumbnail links.
SECRET_KEY=
# Public base of this API and the site that may call it.
API_DOMAIN=api.savideo.example
WEB_DOMAIN=savideo.example
PUBLIC_API_BASE=https://api.savideo.example/v1
WEB_ORIGINS=["https://savideo.example"]
COOKIE_SECURE=true
# Optional: a public video you may share, for the site's "Try a demo video" link.
DEMO_URL=
# Shared parent domain so the site and API share the visitor cookie (optional).
COOKIE_DOMAIN=
# Postgres password used by docker-compose.yml.
POSTGRES_PASSWORD=
# Bearer token for /v1/admin/* (`openssl rand -hex 32`).
ADMIN_TOKEN=

# Free limit and caps (defaults shown).
QUOTA_LIMIT=3
QUOTA_IP_LIMIT=15
MAX_DURATION_S=10800
MAX_AUDIO_DURATION_S=14400
MAX_BYTES=4000000000
# 0 = two FFmpeg processes per CPU core.
FFMPEG_SLOTS=0

# Residential proxy with sticky sessions, {session} is replaced per video. Leave empty for none.
PROXY_URL=

# Optional cookies.txt (Netscape format) for yt-dlp, path inside the container.
# Instagram often answers "login required" without one; use a throwaway account, never a personal one.
COOKIES_FILE=

# Optional: Cloudflare Turnstile on the takedown form, and email on new takedowns / paused platforms.
TURNSTILE_SECRET=
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# One known public test video per platform for the canary (JSON).
CANARY_URLS={}
CANARY_INTERVAL_S=900
